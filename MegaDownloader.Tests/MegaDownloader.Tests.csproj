<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RegressionTests</AssemblyName>
    <RootNamespace>MegaDownloader.Tests</RootNamespace>
    <NoWarn>CS0168;CS0219;CS0414;CS0618;SYSLIB0014;SYSLIB0003;SYSLIB0023;SYSLIB0041;CA1416;WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MegaDownloader.Full/MegaDownloader.Full.csproj" />
    <Reference Include="HttpServer"><HintPath>../src/Resources/DLLs/HttpServer.dll</HintPath></Reference>
    <Reference Include="ObjectListView2022NET"><HintPath>../src/Resources/DLLs/ObjectListView2022NET.dll</HintPath></Reference>
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>
</Project>
