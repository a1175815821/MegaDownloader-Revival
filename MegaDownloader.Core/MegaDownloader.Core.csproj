<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MegaDownloader</RootNamespace>
    <AssemblyName>MegaDownloader.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Cross-platform foundation. This layer intentionally contains only platform-neutral
    abstractions/models. Business logic shared by the desktop UI lives here; UI-coupled
    code stayed in the retired WinForms reference app (see tag winforms-baseline).
  -->
  <ItemGroup>
    <Compile Include="Compat/**/*.cs" />
    <Compile Include="Platform/**/*.cs" />
    <Compile Include="Services/**/*.cs" />
    <Compile Include="Models/**/*.cs" />
    <Compile Include="Engine/**/*.cs" />
    <Compile Include="Settings/**/*.cs" />
  </ItemGroup>

  <!--
    Engine-owned resources. Language packs, the internal configuration and the
    7zr.exe extraction helper belong to the download engine, so they travel with
    MegaDownloader.Core instead of only being embedded in the WinForms shell.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../src/Resources/Language/*-Language.xml" LogicalName="MegaDownloader.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../src/Resources/InternalConfig.xml" LogicalName="MegaDownloader.InternalConfig.xml" />
    <EmbeddedResource Include="../src/Resources/Binaries/7zr.exe" LogicalName="MegaDownloader.7zr.exe" />
    <!--
      Pages served by the built-in web servers. The WinForms build shipped these from
      HttpModule\Template, which never made it into this repository, so the remote
      controller and the streaming library page failed with "Error template not found".
    -->
    <EmbeddedResource Include="../src/Resources/Web/*" LogicalName="MegaDownloader.Web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The WinForms shell (assembly name "MegaDownloader") was split out of the engine,
    but still consumes many engine members that are intentionally not part of the
    public surface. Keep that access working without making the whole engine public;
    the Avalonia UI only uses the public API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="MegaDownloader" />
    <InternalsVisibleTo Include="CoreTests" />
  </ItemGroup>

  <!--
    The embedded HttpServer.dll is replaced by Kestrel. A framework reference keeps the
    ASP.NET Core assemblies out of the package graph; framework-dependent builds need
    the ASP.NET Core runtime, self-contained publishes bundle it.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
