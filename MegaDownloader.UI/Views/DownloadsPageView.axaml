<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MegaDownloader.UI.ViewModels"
             xmlns:controls="using:MegaDownloader.UI.Controls"
             x:Class="MegaDownloader.UI.Views.DownloadsPageView"
             x:DataType="vm:DownloadsPageViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.queue ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The row paints its own selection: the Fluent item highlight would sit on
             top of the row's own background and wash the status colours out. -->
        <Style Selector="ListBox.queue ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.queue ListBoxItem:selected Border.row">
            <Setter Property="Background" Value="{DynamicResource Md.Selection}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Md.ButtonHover}" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="reveal" Margin="20,18,20,14" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <!-- Top bar: title, search, add and the global queue controls. -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="h1" Text="{DynamicResource Loc.TransferQueue}" />
                <TextBlock Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="QueueSearch" MaxWidth="520" HorizontalAlignment="Left" MinWidth="260"
                     VerticalAlignment="Center" Text="{Binding SearchText}"
                     PlaceholderText="{DynamicResource Loc.SearchHint}"
                     AutomationProperties.Name="{DynamicResource Loc.SearchQueue}" IsEnabled="{Binding HasFiles}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="quiet icon toolbar" Command="{Binding StartAllCommand}" IsEnabled="{Binding CanStartAll}"
                        ToolTip.Tip="{DynamicResource Loc.StartQueue}" AutomationProperties.Name="{DynamicResource Loc.StartQueue}">
                    <PathIcon Data="{StaticResource Icon.Play}" />
                </Button>
                <Button Classes="quiet icon toolbar" Command="{Binding PauseAllCommand}" IsEnabled="{Binding CanPauseAll}"
                        ToolTip.Tip="{DynamicResource Loc.PauseQueue}" AutomationProperties.Name="{DynamicResource Loc.PauseQueue}">
                    <PathIcon Data="{StaticResource Icon.Pause}" />
                </Button>
                <Button Classes="quiet icon toolbar" Command="{Binding StopAllCommand}" IsEnabled="{Binding CanStopAll}"
                        ToolTip.Tip="{DynamicResource Loc.StopQueue}" AutomationProperties.Name="{DynamicResource Loc.StopQueue}">
                    <PathIcon Data="{StaticResource Icon.Stop}" />
                </Button>
                <Button Classes="quiet toolbar" Command="{Binding EncodeLinksCommand}" Content="{DynamicResource Loc.EncodeLinks}" />
                <Button Classes="quiet toolbar" Command="{Binding GenerateElcCommand}" Content="{DynamicResource Loc.GenerateELC}" />
                <Button Classes="accent" Command="{Binding AddLinksCommand}" ToolTip.Tip="Ctrl+N"
                        Content="{DynamicResource Loc.AddLinks}" />
            </StackPanel>
        </Grid>

        <!-- Workbench: categories, aligned queue table, on-demand details. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" IsVisible="{Binding HasFiles}">
            <Border Classes="card" Padding="10,12" VerticalAlignment="Stretch" Width="176"
                    IsVisible="{Binding ShowRail}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock Classes="section-title" Text="{DynamicResource Loc.QueueCategories}" Margin="8,0,0,0" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                             ItemContainerTheme="{StaticResource CategoryItemTheme}" Background="Transparent"
                             BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueFilterOption">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CountText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Classes="quiet toolbar" Content="{DynamicResource Loc.RetryFailed}"
                            Command="{Binding RetryFailedCommand}" IsVisible="{Binding HasFailed}"
                            ToolTip.Tip="{DynamicResource Loc.RetryFailed}" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border Background="{DynamicResource Md.AltBack}" BorderBrush="{DynamicResource Md.Border}"
                            BorderThickness="0,0,0,1" IsVisible="{Binding !IsEmpty}">
                        <Grid ColumnDefinitions="*,110,170,Auto,84" ColumnSpacing="12" Margin="14,8">
                            <TextBlock Classes="caption" Text="{DynamicResource Loc.FileOrPackage}" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource Loc.Status}" />
                            <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource Loc.Progress}" />
                            <TextBlock Grid.Column="3" Classes="caption" Text="{DynamicResource Loc.Speed}"
                                       IsVisible="{Binding ShowMetrics}" />
                            <TextBlock Grid.Column="4" Classes="caption" Text="{DynamicResource Loc.Actions}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" IsVisible="{Binding CanBatch}" Background="{DynamicResource Md.Back}"
                            BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,0,0,1" Padding="14,5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="caption" Text="{Binding SelectionCount, StringFormat='{}{0} selected'}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="quiet toolbar" Content="{DynamicResource Loc.Pause}" Command="{Binding BatchPauseCommand}" />
                                <Button Classes="quiet toolbar" Content="{DynamicResource Loc.RetryFailed}" Command="{Binding BatchRetryCommand}" />
                                <Button Classes="quiet toolbar" Content="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding BatchRemoveCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" x:Name="QueueList" Classes="queue" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemsSource="{Binding Downloads}" SelectedItem="{Binding SelectedDownload}" SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="RowDoubleTapped"
                             SelectionChanged="QueueSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Border Classes="row" BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,0,0,1"
                                        MinHeight="46" Padding="14,7" DoubleTapped="RowDoubleTapped">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Loc.StartOrResume}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                                            <MenuItem Header="{DynamicResource Loc.Pause}" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" />
                                            <MenuItem Header="{DynamicResource Loc.RetryFailed}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.MoveToTop}" Command="{Binding MoveToTopCommand}" />
                                            <MenuItem Header="{DynamicResource Loc.MoveUp}" Command="{Binding MoveUpCommand}" />
                                            <MenuItem Header="{DynamicResource Loc.MoveDown}" Command="{Binding MoveDownCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.DownloadIdentity}" Command="{Binding ChangeIdentityCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.OpenFile}" Command="{Binding OpenFileCommand}" />
                                            <MenuItem Header="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.Properties}" Command="{Binding PropertiesCommand}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding RemoveCommand}" />
                                            <MenuItem Header="{DynamicResource Loc.RemoveAndDeleteLocalFiles}" Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="*,110,170,Auto,84" ColumnSpacing="12">
                                        <Grid ColumnDefinitions="Auto,24,*" ColumnSpacing="4" Margin="{Binding RowMargin}">
                                            <Button Classes="quiet icon toolbar" Command="{Binding ToggleExpandedCommand}"
                                                    ToolTip.Tip="{DynamicResource Loc.ExpandOrCollapsePackage}"
                                                    AutomationProperties.Name="{DynamicResource Loc.ExpandOrCollapsePackage}"
                                                    IsVisible="{Binding HasChildren}" Width="22" Height="26" Padding="0">
                                                <TextBlock Text="{Binding Chevron}" FontSize="14" />
                                            </Button>
                                            <PathIcon Grid.Column="1" Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsPackage}"
                                                      Foreground="{DynamicResource Md.Link}" VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1" Data="{StaticResource Icon.File}" IsVisible="{Binding !IsPackage}"
                                                      Foreground="{DynamicResource Md.Muted}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="{Binding TitleWeight}"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="caption" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="caption" Text="{Binding IdentityText}" IsVisible="{Binding HasIdentity}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentityText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Column="1" Classes="chip" Classes.active="{Binding IsActive}"
                                                Classes.waiting="{Binding IsWaiting}" Classes.completed="{Binding IsCompleted}"
                                                Classes.failed="{Binding IsFailed}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource Icon.Play}" Width="11" Height="11" IsVisible="{Binding IsActive}" />
                                                <PathIcon Data="{StaticResource Icon.Clock}" Width="11" Height="11" IsVisible="{Binding IsWaiting}" />
                                                <PathIcon Data="{StaticResource Icon.Check}" Width="11" Height="11" IsVisible="{Binding IsCompleted}" />
                                                <PathIcon Data="{StaticResource Icon.Error}" Width="11" Height="11" IsVisible="{Binding IsFailed}" />
                                                <TextBlock Text="{Binding StateText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <ProgressBar Value="{Binding Progress}" Height="4" MinWidth="0"
                                                             HorizontalAlignment="Stretch"
                                                             IsHitTestVisible="False" Classes.completed="{Binding IsCompleted}"
                                                             Classes.failed="{Binding IsFailed}" />
                                                <TextBlock Grid.Column="1" Classes="numeric" Text="{Binding ProgressText}" />
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Classes="numeric" Text="{Binding SpeedText}"
                                                   IsVisible="{Binding ShowMetrics}" VerticalAlignment="Center" />

                                        <Grid Grid.Column="4" ColumnDefinitions="*,30" VerticalAlignment="Center">
                                            <Button Classes="quiet icon toolbar" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}"
                                                    HorizontalAlignment="Right" Width="24" Height="26" Padding="0"
                                                    ToolTip.Tip="{DynamicResource Loc.StartOrResume}"
                                                    AutomationProperties.Name="{DynamicResource Loc.StartOrResume}">
                                                <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="quiet icon toolbar" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}"
                                                    HorizontalAlignment="Right" Width="24" Height="26" Padding="0"
                                                    ToolTip.Tip="{DynamicResource Loc.Pause}"
                                                    AutomationProperties.Name="{DynamicResource Loc.Pause}">
                                                <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="quiet icon toolbar" Width="26" Height="26" Padding="0"
                                                    ToolTip.Tip="{DynamicResource Loc.TaskOptions}"
                                                    AutomationProperties.Name="{DynamicResource Loc.TaskOptions}">
                                                <PathIcon Data="{StaticResource Icon.More}" Width="15" Height="15" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="{DynamicResource Loc.MoveToTop}" Command="{Binding MoveToTopCommand}" />
                                                        <MenuItem Header="{DynamicResource Loc.MoveUp}" Command="{Binding MoveUpCommand}" />
                                                        <MenuItem Header="{DynamicResource Loc.MoveDown}" Command="{Binding MoveDownCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Loc.DownloadIdentity}" Command="{Binding ChangeIdentityCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Loc.OpenFile}" Command="{Binding OpenFileCommand}" />
                                                        <MenuItem Header="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Loc.Properties}" Command="{Binding PropertiesCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding RemoveCommand}" />
                                                        <MenuItem Header="{DynamicResource Loc.RemoveAndDeleteLocalFiles}" Command="{Binding DeleteCommand}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" IsVisible="{Binding CanResetFilter}" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="{Binding EmptyTitle}" Classes="h2" TextAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding EmptyMessage}" TextAlignment="Center" />
                        <Button Command="{Binding ResetFilterCommand}" Content="{DynamicResource Loc.ShowAllDownloads}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card" Width="300" IsVisible="{Binding ShowDetails}" Padding="16,14">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Details}" />
                        <Button Grid.Column="1" Classes="quiet icon toolbar" Width="26" Height="26" Padding="0"
                                Command="{Binding ToggleDetailsCommand}" Content="×" FontSize="16"
                                ToolTip.Tip="{DynamicResource Loc.CollapseDetails}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelectedDownload}">
                        <StackPanel Spacing="9">
                            <TextBlock Classes="h2" Text="{Binding DetailTitle}" TextWrapping="Wrap" />
                            <Border Classes="chip">
                                <TextBlock Text="{Binding DetailState}" />
                            </Border>
                            <TextBlock Classes="caption" Text="{Binding DetailPath}" TextWrapping="Wrap" IsVisible="{Binding DetailPath}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="5">
                                <TextBlock Classes="caption" Text="{DynamicResource Loc.Size}" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailSize}" />
                                <TextBlock Grid.Row="1" Classes="caption" Text="{DynamicResource Loc.Downloaded}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailDownloaded}" />
                                <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource Loc.Speed}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="numeric" Text="{Binding DetailSpeed}" TextAlignment="Left" />
                                <TextBlock Grid.Row="3" Classes="caption" Text="{DynamicResource Loc.Progress}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="numeric" Text="{Binding DetailProgress}" TextAlignment="Left" />
                                <TextBlock Grid.Row="4" Classes="caption" Text="{DynamicResource Loc.ETA}" IsVisible="{Binding DetailEta}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailEta}" IsVisible="{Binding DetailEta}" />
                                <TextBlock Grid.Row="5" Classes="caption" Text="{DynamicResource Loc.Source}" IsVisible="{Binding DetailSource}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Classes="caption" Text="{Binding DetailSource}" TextWrapping="Wrap"
                                           IsVisible="{Binding DetailSource}" />
                                <TextBlock Grid.Row="6" Classes="caption" Text="{DynamicResource Loc.DownloadIdentity}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DetailIdentity}" TextWrapping="Wrap"
                                           IsVisible="{Binding DetailIdentity}" />
                            </Grid>
                            <Border Classes="notice" Background="{DynamicResource Md.ErrorBack}"
                                    BorderBrush="{DynamicResource Md.ErrorFore}" IsVisible="{Binding HasDetailError}">
                                <TextBlock Classes="caption" Foreground="{DynamicResource Md.ErrorFore}"
                                           Text="{Binding DetailError}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Spacing="4">
                                <Button Classes="quiet toolbar" Content="{DynamicResource Loc.OpenFile}" Command="{Binding OpenSelectedFileCommand}" />
                                <Button Classes="quiet toolbar" Content="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenSelectedFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource Loc.SelectTaskForDetails}"
                               TextWrapping="Wrap" IsVisible="{Binding !HasSelectedDownload}" />
                    <Button Grid.Row="2" Classes="quiet toolbar" Content="{DynamicResource Loc.CollapseDetails}"
                            Command="{Binding ToggleDetailsCommand}" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <!-- Empty state: the first action is adding links. -->
        <Grid Grid.Row="1" IsVisible="{Binding !HasFiles}" RowDefinitions="*,Auto,*">
            <Border Grid.Row="1" Classes="card" MaxWidth="760" HorizontalAlignment="Stretch" Padding="26,22">
                <StackPanel Spacing="13">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Md.Selection}">
                            <PathIcon Data="{StaticResource Icon.Downloads}" Width="20" Height="20"
                                      Foreground="{DynamicResource Md.Accent}" />
                        </Border>
                        <TextBlock Classes="h2" Text="{Binding EmptyTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding EmptyMessage}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding DraftLinks}" AcceptsReturn="True" MinHeight="105" MaxHeight="160" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Loc.MEGALinks}"
                             PlaceholderText="{DynamicResource Loc.PasteMegaLinksOrTextContainingThem}"
                             IsVisible="{Binding CanAddFromEmpty}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caption" Text="{Binding Status}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="accent" Command="{Binding AddLinksCommand}"
                                IsVisible="{Binding CanAddFromEmpty}" Content="{DynamicResource Loc.AddLinks}"
                                ToolTip.Tip="Ctrl+N" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: throughput, waiting state and totals. -->
        <Border Grid.Row="2" IsVisible="{Binding HasFiles}" BorderBrush="{DynamicResource Md.Border}"
                BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid ColumnDefinitions="Auto,Auto,120,*,Auto" ColumnSpacing="12">
                <TextBlock Text="{DynamicResource Loc.TransferSpeed}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TransferSpeed}" Classes="numeric" VerticalAlignment="Center" />
                <controls:TransferGraph Grid.Column="2" History="{Binding SpeedHistory}" Height="26"
                                        LineBrush="{DynamicResource Md.ProgressFill}" GridBrush="{DynamicResource Md.Grid}"
                                        IsHitTestVisible="False" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="{Binding WaitingText}" />
                    <TextBlock Classes="caption" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="4" Classes="quiet toolbar" Content="{Binding DetailsToggleText}"
                        Command="{Binding ToggleDetailsCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
