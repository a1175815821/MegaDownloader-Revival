<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MegaDownloader.UI.ViewModels"
             xmlns:controls="using:MegaDownloader.UI.Controls"
             x:Class="MegaDownloader.UI.Views.DownloadsPageView"
             x:DataType="vm:DownloadsPageViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.queue ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBlock.numeric">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="reveal" Margin="28,20,28,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <!-- Toolbar: title, search, add -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <TextBlock Classes="h1" Text="{DynamicResource Loc.TransferQueue}" VerticalAlignment="Center" FontSize="27"/>
            <TextBox Grid.Column="1" x:Name="QueueSearch" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240" VerticalAlignment="Center"
                     Text="{Binding SearchText}" PlaceholderText="{DynamicResource Loc.SearchHint}"
                     AutomationProperties.Name="{DynamicResource Loc.SearchQueue}" IsVisible="{Binding HasFiles}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="quiet" Command="{Binding EncodeLinksCommand}" Content="{DynamicResource Loc.EncodeLinks}"/>
                <Button Classes="quiet" Command="{Binding GenerateElcCommand}" Content="{DynamicResource Loc.GenerateELC}"/>
                <Button Classes="accent" Command="{Binding AddLinksCommand}" ToolTip.Tip="Ctrl+N" Content="{DynamicResource Loc.AddLinks}"/>
            </StackPanel>
        </Grid>

        <!-- Status strip: counts, filter, queue controls -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasFiles}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center"/>
                <Button Classes="quiet" Content="{DynamicResource Loc.RetryFailed}" Command="{Binding RetryFailedCommand}"
                        IsVisible="{Binding HasFailed}" ToolTip.Tip="{DynamicResource Loc.RetryFailed}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="quiet icon" Command="{Binding StartAllCommand}" IsEnabled="{Binding CanStartAll}"
                        ToolTip.Tip="{DynamicResource Loc.StartQueue}" AutomationProperties.Name="{DynamicResource Loc.StartQueue}">
                    <PathIcon Data="{StaticResource Icon.Play}" />
                </Button>
                <Button Classes="quiet icon" Command="{Binding PauseAllCommand}" IsEnabled="{Binding CanPauseAll}"
                        ToolTip.Tip="{DynamicResource Loc.PauseQueue}" AutomationProperties.Name="{DynamicResource Loc.PauseQueue}">
                    <PathIcon Data="{StaticResource Icon.Pause}" />
                </Button>
                <Button Classes="quiet icon" Command="{Binding StopAllCommand}" IsEnabled="{Binding CanStopAll}"
                        ToolTip.Tip="{DynamicResource Loc.StopQueue}" AutomationProperties.Name="{DynamicResource Loc.StopQueue}">
                    <PathIcon Data="{StaticResource Icon.Stop}" />
                </Button>
                <ComboBox MinWidth="126" MaxWidth="168" Margin="6,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          AutomationProperties.Name="{DynamicResource Loc.FilterByStatus}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueFilterOption">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Queue and details -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="{Binding HasFiles}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Background="{DynamicResource Md.AltBack}" BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,1"
                        IsVisible="{Binding !IsEmpty}">
                    <Grid ColumnDefinitions="2.4*,1*,96" ColumnSpacing="12" Margin="16,7,16,7">
                        <TextBlock Classes="caption" Text="{DynamicResource Loc.FileOrPackage}" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource Loc.Progress}" />
                        <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource Loc.Actions}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Batch bar when more than one row is selected -->
                <Border Grid.Row="1" IsVisible="{Binding CanBatch}" Background="{DynamicResource Md.Back}"
                        BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,1" Padding="16,6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Classes="caption" Text="{Binding SelectionCount, StringFormat='{}{0} selected'}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Classes="quiet" Content="{DynamicResource Loc.Pause}" Command="{Binding BatchPauseCommand}"/>
                            <Button Classes="quiet" Content="{DynamicResource Loc.RetryFailed}" Command="{Binding BatchRetryCommand}"/>
                            <Button Classes="quiet" Content="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding BatchRemoveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" x:Name="QueueList" Classes="queue" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding Downloads}" SelectedItem="{Binding SelectedDownload}"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DoubleTapped="RowDoubleTapped"
                         SelectionChanged="QueueSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <Border BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,0,0,1"
                                    Padding="16,10,16,10" Background="Transparent" DoubleTapped="RowDoubleTapped">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Loc.StartOrResume}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}"/>
                                        <MenuItem Header="{DynamicResource Loc.Pause}" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}"/>
                                        <MenuItem Header="{DynamicResource Loc.RetryFailed}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"/>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.MoveToTop}" Command="{Binding MoveToTopCommand}"/>
                                        <MenuItem Header="{DynamicResource Loc.MoveUp}" Command="{Binding MoveUpCommand}"/>
                                        <MenuItem Header="{DynamicResource Loc.MoveDown}" Command="{Binding MoveDownCommand}"/>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.OpenFile}" Command="{Binding OpenFileCommand}"/>
                                        <MenuItem Header="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenFolderCommand}"/>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.Properties}" Command="{Binding PropertiesCommand}" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding RemoveCommand}" />
                                        <MenuItem Header="{DynamicResource Loc.RemoveAndDeleteLocalFiles}" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="2.4*,1*,96" ColumnSpacing="12">
                                    <Grid ColumnDefinitions="Auto,30,*" ColumnSpacing="6" Margin="{Binding RowMargin}">
                                        <Button Classes="quiet icon" Command="{Binding ToggleExpandedCommand}"
                                                ToolTip.Tip="{DynamicResource Loc.ExpandOrCollapsePackage}"
                                                AutomationProperties.Name="{DynamicResource Loc.ExpandOrCollapsePackage}"
                                                IsVisible="{Binding HasChildren}" Width="26" Height="26" Padding="0">
                                            <TextBlock Text="{Binding Chevron}" FontSize="15" />
                                        </Button>
                                        <PathIcon Grid.Column="1" Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsPackage}"
                                                  Foreground="{DynamicResource Md.Link}" VerticalAlignment="Center"/>
                                        <PathIcon Grid.Column="1" Data="{StaticResource Icon.File}" IsVisible="{Binding !IsPackage}"
                                                  Foreground="{DynamicResource Md.Muted}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="{Binding TitleWeight}"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Classes="caption" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Classes="caption" Text="{Binding StateText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Classes="numeric" Text="{Binding ProgressText}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Progress}" Height="3" CornerRadius="0" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding SpeedText}" Classes="caption" IsVisible="{Binding CanPause}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2" ColumnDefinitions="*,34" VerticalAlignment="Center">
                                        <Button Classes="quiet icon" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" HorizontalAlignment="Right"
                                                Width="26" Height="26" Padding="0"
                                                ToolTip.Tip="{DynamicResource Loc.StartOrResume}" AutomationProperties.Name="{DynamicResource Loc.StartOrResume}">
                                            <PathIcon Data="{StaticResource Icon.Play}" />
                                        </Button>
                                        <Button Classes="quiet icon" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" HorizontalAlignment="Right"
                                                Width="26" Height="26" Padding="0"
                                                ToolTip.Tip="{DynamicResource Loc.Pause}" AutomationProperties.Name="{DynamicResource Loc.Pause}">
                                            <PathIcon Data="{StaticResource Icon.Pause}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="quiet icon" Width="26" Height="26" Padding="0"
                                                ToolTip.Tip="{DynamicResource Loc.TaskOptions}"
                                                AutomationProperties.Name="{DynamicResource Loc.TaskOptions}">
                                            <PathIcon Data="{StaticResource Icon.More}" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="{DynamicResource Loc.MoveToTop}" Command="{Binding MoveToTopCommand}"/>
                                                    <MenuItem Header="{DynamicResource Loc.MoveUp}" Command="{Binding MoveUpCommand}"/>
                                                    <MenuItem Header="{DynamicResource Loc.MoveDown}" Command="{Binding MoveDownCommand}"/>
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Loc.OpenFile}" Command="{Binding OpenFileCommand}"/>
                                                    <MenuItem Header="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenFolderCommand}"/>
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Loc.Properties}" Command="{Binding PropertiesCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Loc.RemoveFromQueue}" Command="{Binding RemoveCommand}" />
                                                    <MenuItem Header="{DynamicResource Loc.RemoveAndDeleteLocalFiles}" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" IsVisible="{Binding CanResetFilter}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock Text="{Binding EmptyTitle}" Classes="h2" TextAlignment="Center"/>
                    <TextBlock Classes="muted" Text="{Binding EmptyMessage}" TextAlignment="Center"/>
                    <Button Command="{Binding ResetFilterCommand}" Content="{DynamicResource Loc.ShowAllDownloads}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Details panel -->
            <Border Grid.Column="1" Width="290" IsVisible="{Binding ShowDetails}" Margin="18,0,0,0"
                    Background="{DynamicResource Md.Back}" BorderBrush="{DynamicResource Md.Border}" BorderThickness="1,0,0,0"
                    Padding="16,10">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" IsVisible="{Binding SelectedDownload, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="h2" Text="{Binding DetailTitle}" TextWrapping="Wrap"/>
                        <TextBlock Classes="caption" Text="{Binding DetailState}"/>
                        <TextBlock Classes="caption" Text="{Binding DetailPath}" TextWrapping="Wrap" IsVisible="{Binding DetailPath}"/>
                        <TextBlock Classes="caption" Text="{Binding DetailSize}"/>
                        <TextBlock Classes="caption" Classes.error="{Binding HasDetailError}" Text="{Binding DetailError}"
                                   TextWrapping="Wrap" IsVisible="{Binding HasDetailError}"/>
                        <StackPanel Spacing="4">
                            <Button Classes="quiet" Content="{DynamicResource Loc.OpenFile}" Command="{Binding OpenSelectedFileCommand}"/>
                            <Button Classes="quiet" Content="{DynamicResource Loc.OpenFolder}" Command="{Binding OpenSelectedFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Empty state -->
        <Grid Grid.Row="2" IsVisible="{Binding !HasFiles}" RowDefinitions="*,Auto,*">
            <Border Grid.Row="1" MaxWidth="690" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,2,0,1" Padding="0,23,0,20">
                <StackPanel Spacing="13">
                    <TextBlock Classes="h2" FontSize="27" Text="{Binding EmptyTitle}"/>
                    <TextBlock Classes="muted" Text="{Binding EmptyMessage}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding DraftLinks}" AcceptsReturn="True" MinHeight="95" MaxHeight="145" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" AutomationProperties.Name="{DynamicResource Loc.MEGALinks}"
                             PlaceholderText="{DynamicResource Loc.PasteMegaLinksOrTextContainingThem}" IsVisible="{Binding CanAddFromEmpty}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caption" Text="{Binding Status}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="accent" Command="{Binding AddLinksCommand}" IsVisible="{Binding CanAddFromEmpty}"
                                Content="{DynamicResource Loc.AddLinks}" ToolTip.Tip="Ctrl+N"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: transfer speed and totals -->
        <Border Grid.Row="3" IsVisible="{Binding HasFiles}" BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid ColumnDefinitions="Auto,Auto,95,*,Auto" ColumnSpacing="12">
                <TextBlock Text="{DynamicResource Loc.TransferSpeed}" Classes="caption" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TransferSpeed}" Classes="numeric" VerticalAlignment="Center"/>
                <controls:TransferGraph Grid.Column="2" History="{Binding SpeedHistory}" Height="25"
                                        LineBrush="{DynamicResource Md.ProgressFill}" GridBrush="{DynamicResource Md.Grid}" IsHitTestVisible="False"/>
                <Button Grid.Column="3" Classes="quiet" HorizontalAlignment="Left" Margin="6,0,0,0"
                        Content="{Binding DetailsToggleText}" Command="{Binding ToggleDetailsCommand}"/>
                <TextBlock Grid.Column="4" Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
