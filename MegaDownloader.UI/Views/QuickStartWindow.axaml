<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MegaDownloader.UI.Views"
        x:Class="MegaDownloader.UI.Views.QuickStartWindow"
        Title="{DynamicResource Loc.QuickStart}" Width="600" Height="420" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanResize="True">

    <Window.Styles>
        <Style Selector="Border.stepMark"><Setter Property="Background" Value="{DynamicResource Md.Border}"/></Style>
        <Style Selector="Border.stepMark.current"><Setter Property="Background" Value="{DynamicResource Md.Accent}"/></Style>
    </Window.Styles>
    <Grid Classes="reveal" RowDefinitions="*,Auto">
        <Grid Margin="30,25" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="{DynamicResource Loc.QuickStart}"/>
                <TextBlock Grid.Column="1" x:Name="ProgressLabel" Classes="caption"/>
            </Grid>
            <TransitioningContentControl Grid.Row="1" x:Name="StepContent" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" ClipToBounds="True">
                <TransitioningContentControl.PageTransition><CrossFade Duration="0:0:0.2"/></TransitioningContentControl.PageTransition>
                <TransitioningContentControl.ContentTemplate><DataTemplate x:DataType="views:QuickStartStep">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="13" Margin="0,12">
                            <TextBlock Text="{Binding Title}" Classes="h1" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="16" LineHeight="25"/>
                            <Border BorderBrush="{DynamicResource Md.Border}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,12,0,0">
                                <TextBlock Text="{Binding Tip}" Classes="muted" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate></TransitioningContentControl.ContentTemplate>
            </TransitioningContentControl>
            <ItemsControl Grid.Row="2" x:Name="Steps" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="views:QuickStartStep">
                    <Border Width="32" Height="3" Classes="stepMark" Classes.current="{Binding IsCurrent}"/>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Border Grid.Row="1" Classes="band" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Classes="quiet" Click="Skip" IsCancel="True" Content="{DynamicResource Loc.SkipGuide}"/>
                <Button Grid.Column="2" x:Name="BackButton" Click="Back" Content="{DynamicResource Loc.Back}"/>
                <Button Grid.Column="3" x:Name="NextButton" Classes="accent" Click="Next" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>