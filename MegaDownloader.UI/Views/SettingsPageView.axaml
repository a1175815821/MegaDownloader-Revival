<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MegaDownloader.UI.ViewModels"
             x:Class="MegaDownloader.UI.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Classes="h1" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Download defaults and appearance. Account, streaming and pre-shared-key tabs follow later in Phase 3." />

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="Downloads" Classes="h2" />

                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="12" ColumnSpacing="12">
                        <TextBlock Text="Default folder" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding DefaultFolder}" Watermark="Folder used by the add-links window" />
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseFolderCommand}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Simultaneous downloads" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding SimultaneousDownloads}"
                                       Minimum="1" Maximum="20" Increment="1"
                                       FormatString="0"
                                       Width="140" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="2" Text="Connections per file" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding ConnectionsPerFile}"
                                       Minimum="1" Maximum="16" Increment="1"
                                       FormatString="0"
                                       Width="140" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="3" Text="Package defaults" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                            <CheckBox Content="Create a subfolder for each package"
                                      IsChecked="{Binding CreateSubdirectory}" />
                            <CheckBox Content="Extract archives automatically"
                                      IsChecked="{Binding ExtractArchives}" />
                            <CheckBox Content="Start downloads when the app opens"
                                      IsChecked="{Binding StartOnLaunch}" />
                            <CheckBox Content="Remember the last used add-links options"
                                      IsChecked="{Binding KeepLastOptions}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding SaveStatus}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" Classes="h2" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Width="120" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"
                                  Width="220" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="Auto follows the operating system light/dark setting." />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Storage" Classes="h2" />
                    <TextBlock Text="Application data" Classes="muted" />
                    <TextBox Text="{Binding AppDataPath, Mode=OneWay}" IsReadOnly="True" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Classes="h2" />
                    <TextBlock Classes="muted" Text="{Binding VersionText, StringFormat='Version {0}'}" />
                    <TextBlock Classes="caption"
                               TextWrapping="Wrap"
                               Text="The 11 XML language packs and the remaining WinForms tabs are ported as Phase 3 continues." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
