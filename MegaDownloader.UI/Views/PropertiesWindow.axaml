<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.PropertiesWindow"
        x:DataType="vm:PropertiesViewModel"
        Title="{DynamicResource Loc.PropertiesLabel}"
        Width="660" Height="640"
        MinWidth="560" MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="26,18" RowSpacing="14" Classes="reveal">

        <Border BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Header}" Classes="h1" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Name}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <Border Classes="card" Padding="16">
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Text="{DynamicResource Loc.Status}" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" />

                        <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Size}" Classes="muted" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" />

                        <TextBlock Grid.Row="2" Text="URL" Classes="muted" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Url, Mode=OneWay}"
                                 IsReadOnly="True" />

                        <TextBlock Grid.Row="3" Text="MD5" Classes="muted" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Md5, Mode=OneWay}"
                                 IsReadOnly="True" />
                    </Grid>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Loc.Location}" Classes="h2" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Path}"
                                     IsEnabled="{Binding CanEditPath}"
                                     Watermark="{DynamicResource Loc.DownloadFolder}" />
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Loc.Browse}"
                                    Command="{Binding BrowseCommand}"
                                    IsEnabled="{Binding CanEditPath}" />
                        </Grid>
                        <TextBlock Classes="caption"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Loc.FilesThatHaveAlreadyStartedKeepTheirCurrentFolder}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Loc.Options}" Classes="h2" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox Content="{DynamicResource Loc.LimitSpeedTo}" IsChecked="{Binding LimitSpeed}" />
                            <TextBox Text="{Binding SpeedLimitText}"
                                     IsEnabled="{Binding LimitSpeed}"
                                     Watermark="{DynamicResource Loc.EG512KBSOr2MBS}"
                                     Width="220" />
                        </StackPanel>

                        <CheckBox Content="{DynamicResource Loc.ExtractArchivesAutomatically}" IsChecked="{Binding ExtractArchives}" />
                        <TextBox Text="{Binding Password}"
                                 IsEnabled="{Binding ExtractArchives}"
                                 PasswordChar="●"
                                 Watermark="{DynamicResource Loc.ArchivePasswordOptional}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="notice"
                           Text="{Binding Notice}"
                           IsVisible="{Binding HasNotice}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource Loc.Cancel}" Command="{Binding CancelCommand}" />
            <Button Content="{DynamicResource Loc.SaveLabel}" Classes="accent" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
