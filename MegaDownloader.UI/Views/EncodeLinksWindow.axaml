<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.EncodeLinksWindow" x:DataType="vm:EncodeLinksViewModel"
        Title="{DynamicResource Loc.EncodeLinks}" Width="876" Height="508" MinWidth="705" MinHeight="395"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Classes="reveal" RowDefinitions="Auto,*,Auto" Margin="26,18" RowSpacing="14">
        <Border BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Loc.EncodeLinks}" Classes="h1" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource Loc.ConvertMEGALinksToTheEncodedMegaEncFormat}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="card" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="{DynamicResource Loc.OriginalLinks}" Classes="h2" />
                    <TextBox Grid.Row="1" Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Watermark="{DynamicResource Loc.PasteMegaLinksOrTextContainingThem}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="{DynamicResource Loc.EncodedLinks}" Classes="h2" />
                    <TextBox Grid.Row="1" Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource Loc.Close}" Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Grid.Column="2" Content="{DynamicResource Loc.CopyResult}" Command="{Binding CopyResultCommand}" />
            <Button Grid.Column="3" Content="{DynamicResource Loc.Encode}" Classes="accent" Command="{Binding EncodeCommand}" />
        </Grid>
    </Grid>
</Window>
