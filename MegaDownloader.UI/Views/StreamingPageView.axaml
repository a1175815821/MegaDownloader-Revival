<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MegaDownloader.UI.ViewModels"
             x:Class="MegaDownloader.UI.Views.StreamingPageView"
             x:DataType="vm:StreamingPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
        <Style Selector="ListBox.library">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.library ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Classes="reveal" Margin="36,22,36,16" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Loc.StreamingLibrary}" Classes="h1" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="{DynamicResource Loc.OrganizeLinksForPlaybackOnYourLocalStreamingServer}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{DynamicResource Loc.Refresh}" Command="{Binding RefreshCommand}" />
                <Button Content="{DynamicResource Loc.NewEntry}" Classes="accent" Command="{Binding NewCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1*,1.85*" ColumnSpacing="24">
            <Border BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Md.Fore}" Padding="0,10">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="{DynamicResource Loc.Entries}" Classes="h2" Margin="8,6,5,2" />
                    <ListBox Grid.Row="1" Classes="library"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StreamingRowViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="caption" Text="{Binding LinkText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               Classes="caption" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="10"
                               Text="{DynamicResource Loc.NoEntriesYetUseNewEntryToAddOne}"
                               IsVisible="{Binding !HasItems}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Md.Border}" Padding="24,0,0,0">
                <Grid RowDefinitions="*,Auto" RowSpacing="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding EditorTitle}" Classes="h2" />

<Grid ColumnDefinitions="126,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10"><TextBlock Grid.Row="0" Text="{DynamicResource Loc.Name}" VerticalAlignment="Center" />
<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Watermark="{DynamicResource Loc.DisplayName}" />
<TextBlock Grid.Row="1" Text="{DynamicResource Loc.Link}" VerticalAlignment="Center" />
<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Link}" Watermark="{DynamicResource Loc.MegaLink}" />
<TextBlock Grid.Row="2" Text="{DynamicResource Loc.Visibility}" VerticalAlignment="Center" />
<CheckBox Grid.Row="2" Grid.Column="1"
                                      Content="{DynamicResource Loc.ShowTheLinkInTheStreamingLibrary}"
                                      IsChecked="{Binding LinkVisible}" /></Grid>
                        <Expander Header="{DynamicResource Loc.Advanced}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
<Grid ColumnDefinitions="126,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10"><TextBlock Grid.Row="0" Text="{DynamicResource Loc.Description}" VerticalAlignment="Top" Margin="0,6,0,0" />
<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Description}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
<TextBlock Grid.Row="1" Text="{DynamicResource Loc.Comments}" VerticalAlignment="Top" Margin="0,6,0,0" />
<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Comments}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
<TextBlock Grid.Row="2" Text="{DynamicResource Loc.PosterURL}" VerticalAlignment="Center" />
<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Poster}" Watermark="https://…" />
<TextBlock Grid.Row="3" Text="IMDB" VerticalAlignment="Center" />
<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Imdb}" Watermark="tt…" />
<TextBlock Grid.Row="4" Text="Allociné" VerticalAlignment="Center" />
<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Allocine}" />
<TextBlock Grid.Row="5" Text="Filmaffinity" VerticalAlignment="Center" />
<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Filmaffinity}" /></Grid>
                        </Expander>


                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Spacing="10">
                        <TextBlock Classes="status"
                                   Classes.error="{Binding StatusIsError}"
                                   Text="{Binding Status}"
                                   IsVisible="{Binding HasStatus}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{DynamicResource Loc.SaveLabel}" Classes="accent" Command="{Binding SaveCommand}" />
                            <Button Content="{DynamicResource Loc.Play}"
                                    Command="{Binding PlayCommand}"
                                    IsEnabled="{Binding HasSelection}" />
                            <Button Content="{DynamicResource Loc.Delete}"
                                    Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding HasSelection}" />
                        </StackPanel>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
