<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mega Downloader"
        Width="1360" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="210,*" RowDefinitions="Auto,*,Auto">

        <!-- Left navigation rail -->
        <Border Grid.RowSpan="3" Grid.Column="0"
                Background="{DynamicResource Md.Back}"
                BorderBrush="{DynamicResource Md.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14" Spacing="2">
                    <TextBlock Text="MEGA"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Md.Accent}" />
                    <TextBlock Text="Downloader" Classes="caption" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,14" Spacing="8">
                    <Button Content="{Binding ThemeLabel}"
                            Command="{Binding CycleThemeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}"
                               Classes="caption"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         ItemContainerTheme="{StaticResource NavItemTheme}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="{DynamicResource Md.ToolBack}"
                BorderBrush="{DynamicResource Md.ToolBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="Add links" Command="{Binding AddLinksCommand}" />
                    <Button Content="Encode links" Command="{Binding EncodeLinksCommand}" />
                    <Button Content="ELC" Command="{Binding GenerateElcCommand}" />
                    <Button Content="Start"
                            Command="{Binding DownloadsPage.StartAllCommand}"
                            IsEnabled="{Binding DownloadsPage.CanStartAll}"
                            ToolTip.Tip="Start or resume the queue" />
                    <Button Content="Pause"
                            Command="{Binding DownloadsPage.PauseAllCommand}"
                            IsEnabled="{Binding DownloadsPage.CanPauseAll}"
                            ToolTip.Tip="Pause the queue" />
                    <Button Content="Stop"
                            Command="{Binding DownloadsPage.StopAllCommand}"
                            IsEnabled="{Binding DownloadsPage.CanStopAll}"
                            ToolTip.Tip="Stop active downloads" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentPage}" />

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.Row="2"
                Background="{DynamicResource Md.ToolBack}"
                BorderBrush="{DynamicResource Md.ToolBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RuntimeText}" Classes="caption" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
