<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mega Downloader" Icon="/Assets/App.ico" Width="1260" Height="790" MinWidth="930" MinHeight="625"
        WindowStartupLocation="CenterScreen">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddLinksCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ShowGuideCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="32,0" BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,0,0,1">
            <Grid Height="70" ColumnDefinitions="Auto,*,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                    <Viewbox Width="35" Height="34" VerticalAlignment="Center"><Canvas Width="36" Height="34"><Path Fill="{DynamicResource Md.Accent}" Data="M2,22 L18,30 L34,22 L34,27 L18,35 L2,27 Z M2,15 L18,23 L34,15 L34,20 L18,28 L2,20 Z M2,8 L18,0 L34,8 L18,16 Z"/></Canvas></Viewbox>
                    <TextBlock Text="Mega Downloader" VerticalAlignment="Center" FontFamily="Georgia" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <ListBox Grid.Column="2" x:Name="Navigation" ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}" ItemContainerTheme="{StaticResource NavItemTheme}"
                         Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NavigationItemViewModel">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button Classes="quiet icon" Command="{Binding ShowGuideCommand}" ToolTip.Tip="{DynamicResource Loc.QuickStart}" AutomationProperties.Name="{DynamicResource Loc.QuickStart}"><PathIcon Data="{StaticResource Icon.Help}"/></Button>
                    <Button Classes="quiet icon" Command="{Binding CycleThemeCommand}" ToolTip.Tip="{Binding ThemeLabel}" AutomationProperties.Name="{Binding ThemeLabel}">
                        <PathIcon Data="{Binding ThemeIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}" ClipToBounds="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TransitioningContentControl.PageTransition><CrossFade Duration="0:0:0.18"/></TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
        <Border Grid.Row="2" Classes="band" Padding="32,7"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <TextBlock Classes="caption" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" ToolTip.Tip="{Binding StatusText}"/>
            <TextBlock Grid.Column="1" Classes="caption" FontFamily="Consolas" Text="{Binding VersionText}"/>
        </Grid></Border>
    </Grid>
</Window>