<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.AddLinksWindow"
        x:DataType="vm:AddLinksViewModel"
        Title="Add links"
        Width="900" Height="780"
        MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
        </Style>
        <Style Selector="TextBlock.notice.error">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
        <Style Selector="TextBlock.state">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
        </Style>
        <Style Selector="TextBlock.state.ready">
            <Setter Property="Foreground" Value="{DynamicResource Md.SuccessFore}" />
        </Style>
        <Style Selector="TextBlock.state.error">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
        <Style Selector="ListBox.preflight">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.preflight ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Add links" Classes="h1" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Paste Mega file or folder links, check them, then add the selected files to the download queue." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <StackPanel Spacing="6">
                    <TextBlock Text="Links" Classes="h2" />
                    <TextBox Text="{Binding LinksText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="120"
                             VerticalContentAlignment="Top"
                             Watermark="https://mega.nz/file/… — one link per line" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Download folder" Classes="h2" />
                        <TextBox Text="{Binding Destination}" Watermark="Choose a folder" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding BrowseCommand}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Package options" Classes="h2" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                            <CheckBox Content="Create a subfolder for this package"
                                      IsChecked="{Binding CreateSubdirectory}" />
                            <CheckBox Grid.Column="1"
                                      Content="Extract archives automatically"
                                      IsChecked="{Binding ExtractArchives}" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding PackageName}"
                                     Watermark="Package name (optional)" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding Password}"
                                     PasswordChar="●"
                                     Watermark="Archive password (optional)" />
                        </Grid>
                        <CheckBox Content="Start downloading after adding" IsChecked="{Binding StartDownload}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Content="Check links"
                                Classes="accent"
                                Command="{Binding CheckCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 IsVisible="{Binding IsInspecting}"
                                 Height="4" />
                </StackPanel>

                <Border Classes="card" Padding="12" IsVisible="{Binding HasEntries}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding FilterText}"
                                     Watermark="Filter by name…"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectionSummary}"
                                       Classes="caption"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Select all" Command="{Binding SelectAllCommand}" />
                            <Button Grid.Column="3" Content="Clear" Command="{Binding ClearSelectionCommand}" />
                        </Grid>

                        <ListBox Classes="preflight"
                                 ItemsSource="{Binding VisibleEntries}"
                                 Height="300"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreflightRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption"
                                                       Text="{Binding Detail}"
                                                       IsVisible="{Binding HasDetail}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" MinWidth="120">
                                            <TextBlock Classes="state"
                                                       Classes.ready="{Binding IsReady}"
                                                       Classes.error="{Binding IsErrorState}"
                                                       Text="{Binding StateText}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Classes="caption"
                                                       Text="{Binding SizeText}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <TextBlock Classes="notice"
                           Classes.error="{Binding NoticeIsError}"
                           Text="{Binding Notice}"
                           IsVisible="{Binding HasNotice}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="{Binding AddButtonText}"
                    Classes="accent"
                    Command="{Binding AddCommand}" />
        </StackPanel>
    </Grid>
</Window>
