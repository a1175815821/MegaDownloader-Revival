<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.ElcGenerateWindow" x:DataType="vm:ElcGenerateViewModel"
        Title="{DynamicResource Loc.GenerateELC}" Width="955" Height="590" MinWidth="755" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
    </Window.Styles>
    <Grid Classes="reveal" RowDefinitions="Auto,Auto,*,Auto" Margin="26,18" RowSpacing="14">
        <Border BorderBrush="{DynamicResource Md.Fore}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Loc.GenerateELC}" Classes="h1" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource Loc.SignMEGALinksUsingAConfiguredELCAccount}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="{DynamicResource Loc.Account}" Classes="label" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" />
                <Button Grid.Column="2" Content="{DynamicResource Loc.ManageAccounts}" Command="{Binding ManageAccountsCommand}" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="card" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock Text="{DynamicResource Loc.Links}" Classes="h2" />
                    <TextBox Grid.Row="1" Text="{Binding LinksText}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Watermark="{DynamicResource Loc.PasteMegaLinksOnePerLine}" />
                    <CheckBox Grid.Row="2" Content="{DynamicResource Loc.GenerateOneELCPerLink}" IsChecked="{Binding OnePerLink}" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock Text="{DynamicResource Loc.Result}" Classes="h2" />
                    <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" AcceptsReturn="True" IsReadOnly="True"
                             VerticalContentAlignment="Top" TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,6,0" Content="{DynamicResource Loc.CopyResult}" Command="{Binding CopyResultCommand}" />
                        <Button Content="{DynamicResource Loc.Save}" Command="{Binding SaveResultCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Status}" Classes="caption" Classes.error="{Binding StatusIsError}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource Loc.Close}" Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Grid.Column="2" Content="{DynamicResource Loc.Generate}" Classes="accent" Command="{Binding GenerateCommand}" />
        </Grid>
    </Grid>
</Window>
