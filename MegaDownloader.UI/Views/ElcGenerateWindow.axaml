<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaDownloader.UI.ViewModels"
        x:Class="MegaDownloader.UI.Views.ElcGenerateWindow"
        x:DataType="vm:ElcGenerateViewModel"
        Title="Generate ELC"
        Width="820" Height="720"
        MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Generate ELC" Classes="h1" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Signs links on the ELC server and returns mega://elc links. The account must be configured first." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2" Content="Manage accounts…" Command="{Binding ManageAccountsCommand}" />
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Links" Classes="h2" />
                    <TextBox Text="{Binding LinksText}"
                             AcceptsReturn="True"
                             Height="140"
                             TextWrapping="Wrap"
                             Watermark="Paste Mega links — one per line" />
                    <CheckBox Content="Generate one ELC per link" IsChecked="{Binding OnePerLink}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Generate" Classes="accent" Command="{Binding GenerateCommand}" />
                    <TextBlock Classes="status"
                               Classes.error="{Binding StatusIsError}"
                               Text="{Binding Status}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Result" Classes="h2" />
                    <TextBox Text="{Binding ResultText, Mode=OneWay}"
                             AcceptsReturn="True"
                             Height="160"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy result" Command="{Binding CopyResultCommand}" />
                        <Button Content="Save…" Command="{Binding SaveResultCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
