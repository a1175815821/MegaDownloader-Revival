<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MegaDownloader.UI</RootNamespace>
    <AssemblyName>MegaDownloader</AssemblyName>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
    <Version>2.6.7.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MegaDownloader.Core/MegaDownloader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**/*" />
    <EmbeddedResource Include="Localization/*.json" LogicalName="Desktop.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    MEGA account bridge. The Windows x64 library ships in the repository; macOS and
    Linux builds are produced by .github/workflows/native-account.yml and can be
    placed under prebuilt/<rid>/ before publishing.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">
    <Content Include="../Native/MegaAccount/prebuilt/x64/*.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Native/MegaAccount/prebuilt/x64/MEGA-SDK-LICENSE.txt"
             Link="MEGA-SDK-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' and Exists('../Native/MegaAccount/prebuilt/osx-arm64/libMegaAccountBridge.dylib')">
    <Content Include="../Native/MegaAccount/prebuilt/osx-arm64/libMegaAccountBridge.dylib"
             Link="libMegaAccountBridge.dylib"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Native/MegaAccount/prebuilt/osx-arm64/MEGA-SDK-LICENSE.txt"
             Link="MEGA-SDK-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('../Native/MegaAccount/prebuilt/linux-x64/libMegaAccountBridge.so')">
    <Content Include="../Native/MegaAccount/prebuilt/linux-x64/libMegaAccountBridge.so"
             Link="libMegaAccountBridge.so"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Native/MegaAccount/prebuilt/linux-x64/MEGA-SDK-LICENSE.txt"
             Link="MEGA-SDK-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
