<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Md.Rail" Color="#241F1C" />
    <SolidColorBrush x:Key="Md.RailFore" Color="#FBF5E9" />
    <SolidColorBrush x:Key="Md.RailMuted" Color="#CBC0B2" />
    <SolidColorBrush x:Key="Md.RailLine" Color="#51493F" />
    <SolidColorBrush x:Key="Md.RailHover" Color="#443A32" />
    <SolidColorBrush x:Key="Md.RailSelected" Color="#624337" />
    <SolidColorBrush x:Key="Md.RailAccent" Color="#FFAD8C" />
    <SolidColorBrush x:Key="Md.Guide" Color="#412C23" />
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Md.Canvas" Color="#F8F5ED" />
            <SolidColorBrush x:Key="Md.Back" Color="#FBF9F2" />
            <SolidColorBrush x:Key="Md.AltBack" Color="#F0EADF" />
            <SolidColorBrush x:Key="Md.InputBack" Color="#FFFCF5" />
            <SolidColorBrush x:Key="Md.Fore" Color="#25241E" />
            <SolidColorBrush x:Key="Md.Muted" Color="#655E54" />
            <SolidColorBrush x:Key="Md.Border" Color="#D5CEC1" />
            <SolidColorBrush x:Key="Md.ButtonBack" Color="#FAF7EF" />
            <SolidColorBrush x:Key="Md.ButtonBorder" Color="#ADA595" />
            <SolidColorBrush x:Key="Md.ButtonHover" Color="#EDE7DA" />
            <SolidColorBrush x:Key="Md.ButtonPressed" Color="#DFD8C9" />
            <SolidColorBrush x:Key="Md.ButtonDisabledBack" Color="#EEEAE0" />
            <SolidColorBrush x:Key="Md.ButtonDisabledFore" Color="#776F62" />
            <SolidColorBrush x:Key="Md.ButtonDisabledBorder" Color="#DFD9CF" />
            <SolidColorBrush x:Key="Md.Selection" Color="#F6E0D4" />
            <SolidColorBrush x:Key="Md.SelectionFore" Color="#812C16" />
            <SolidColorBrush x:Key="Md.Accent" Color="#AD341C" />
            <SolidColorBrush x:Key="Md.AccentFore" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Md.AccentHover" Color="#922A17" />
            <SolidColorBrush x:Key="Md.AccentPressed" Color="#702113" />
            <SolidColorBrush x:Key="Md.Link" Color="#91341F" />
            <SolidColorBrush x:Key="Md.ErrorFore" Color="#9D272B" />
            <SolidColorBrush x:Key="Md.ErrorBack" Color="#F7E1D9" />
            <SolidColorBrush x:Key="Md.SuccessFore" Color="#346043" />
            <SolidColorBrush x:Key="Md.SuccessBack" Color="#E3EADB" />
            <SolidColorBrush x:Key="Md.ProgressBack" Color="#D8D1C3" />
            <SolidColorBrush x:Key="Md.ProgressFill" Color="#AC381E" />
            <SolidColorBrush x:Key="Md.Grid" Color="#CEC5B5" />
            <Color x:Key="SystemAccentColor">#AD341C</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Md.Canvas" Color="#23221E" />
            <SolidColorBrush x:Key="Md.Back" Color="#2A2823" />
            <SolidColorBrush x:Key="Md.AltBack" Color="#312F28" />
            <SolidColorBrush x:Key="Md.InputBack" Color="#24221C" />
            <SolidColorBrush x:Key="Md.Fore" Color="#F5EFDF" />
            <SolidColorBrush x:Key="Md.Muted" Color="#C3BBA9" />
            <SolidColorBrush x:Key="Md.Border" Color="#494538" />
            <SolidColorBrush x:Key="Md.ButtonBack" Color="#343128" />
            <SolidColorBrush x:Key="Md.ButtonBorder" Color="#6B6352" />
            <SolidColorBrush x:Key="Md.ButtonHover" Color="#433E33" />
            <SolidColorBrush x:Key="Md.ButtonPressed" Color="#534B3D" />
            <SolidColorBrush x:Key="Md.ButtonDisabledBack" Color="#343129" />
            <SolidColorBrush x:Key="Md.ButtonDisabledFore" Color="#B5AC99" />
            <SolidColorBrush x:Key="Md.ButtonDisabledBorder" Color="#454034" />
            <SolidColorBrush x:Key="Md.Selection" Color="#563529" />
            <SolidColorBrush x:Key="Md.SelectionFore" Color="#FFB99D" />
            <SolidColorBrush x:Key="Md.Accent" Color="#FAAA86" />
            <SolidColorBrush x:Key="Md.AccentFore" Color="#2E1910" />
            <SolidColorBrush x:Key="Md.AccentHover" Color="#FFC2A5" />
            <SolidColorBrush x:Key="Md.AccentPressed" Color="#E79571" />
            <SolidColorBrush x:Key="Md.Link" Color="#FFB093" />
            <SolidColorBrush x:Key="Md.ErrorFore" Color="#FFAEA3" />
            <SolidColorBrush x:Key="Md.ErrorBack" Color="#51302B" />
            <SolidColorBrush x:Key="Md.SuccessFore" Color="#B8D6A8" />
            <SolidColorBrush x:Key="Md.SuccessBack" Color="#303C2D" />
            <SolidColorBrush x:Key="Md.ProgressBack" Color="#494337" />
            <SolidColorBrush x:Key="Md.ProgressFill" Color="#F8A480" />
            <SolidColorBrush x:Key="Md.Grid" Color="#4A4539" />
            <Color x:Key="SystemAccentColor">#FAAA86</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
