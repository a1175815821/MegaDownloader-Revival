<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="NavItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Md.SidebarMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="PART_Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" />
                        <Grid ColumnDefinitions="3,*" Margin="1">
                            <Border Name="PART_Indicator" Background="Transparent" CornerRadius="2" Margin="0,7" />
                            <Border Grid.Column="1" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalContentAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource Md.SidebarSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource Md.SidebarFore}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource Md.SidebarSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource Md.SidebarFore}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_Indicator">
                <Setter Property="Background" Value="{DynamicResource Md.SidebarAccent}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_Focus">
                <Setter Property="BorderBrush" Value="{DynamicResource Md.SidebarAccent}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CategoryItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource Md.AltBack}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource Md.Selection}" />
                <Setter Property="Foreground" Value="{DynamicResource Md.SelectionFore}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Md.Canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
        <Setter Property="FontFamily" Value="{DynamicResource Md.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource Md.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Md.FontFamily}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="TextBlock.sidebar-label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource Md.SidebarMuted}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.readout">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource Md.NumericFont}" />
    </Style>
    <Style Selector="TextBlock.numeric">
        <Setter Property="FontFamily" Value="{DynamicResource Md.NumericFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.section">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,14" />
    </Style>
    <Style Selector="Border.setting">
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,10" />
    </Style>
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.band">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource Md.AltBack}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="Border.chip.active">
        <Setter Property="Background" Value="{DynamicResource Md.ActiveBack}" />
    </Style>
    <Style Selector="Border.chip.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Md.ActiveFore}" />
    </Style>
    <Style Selector="Border.chip.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Md.ActiveFore}" />
    </Style>
    <Style Selector="Border.chip.waiting">
        <Setter Property="Background" Value="{DynamicResource Md.WaitingBack}" />
    </Style>
    <Style Selector="Border.chip.waiting TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Md.WaitingFore}" />
    </Style>
    <Style Selector="Border.chip.waiting PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Md.WaitingFore}" />
    </Style>
    <Style Selector="Border.chip.completed">
        <Setter Property="Background" Value="{DynamicResource Md.CompletedBack}" />
    </Style>
    <Style Selector="Border.chip.completed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Md.CompletedFore}" />
    </Style>
    <Style Selector="Border.chip.completed PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Md.CompletedFore}" />
    </Style>
    <Style Selector="Border.chip.failed">
        <Setter Property="Background" Value="{DynamicResource Md.FailedBack}" />
    </Style>
    <Style Selector="Border.chip.failed TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Md.FailedFore}" />
    </Style>
    <Style Selector="Border.chip.failed PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Md.FailedFore}" />
    </Style>
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource Md.AltBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.rail">
        <Setter Property="Foreground" Value="{DynamicResource Md.RailMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="Background" Value="{DynamicResource Md.InputBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.ButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <!-- An expander group inside a settings section: the Fluent header paints a solid
         block that reads as a separate card, so it is flattened into the section. -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Md.AltBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource Md.ButtonHover}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Md.ProgressFill}" />
        <Setter Property="Background" Value="{DynamicResource Md.ProgressBack}" />
        <Setter Property="MinHeight" Value="4" />
        <!-- The Fluent default is 200, wider than the queue's progress column; left
             alone the bar overflows its cell and the percentage sits on top of it. -->
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ProgressBar.completed">
        <Setter Property="Foreground" Value="{DynamicResource Md.CompletedFore}" />
    </Style>
    <Style Selector="ProgressBar.failed">
        <Setter Property="Foreground" Value="{DynamicResource Md.ErrorFore}" />
    </Style>

    <Style Selector="Grid.reveal">
        <Style.Animations>
            <Animation Duration="0:0:0.20" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="7" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
