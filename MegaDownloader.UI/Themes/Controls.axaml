<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="NavItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="19,0" />
            <Setter Property="MinHeight" Value="69" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource Md.AltBack}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="BorderBrush" Value="{DynamicResource Md.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="BorderBrush" Value="{DynamicResource Md.Accent}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Md.Canvas}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontFamily" Value="Georgia, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Muted}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.readout">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.band">
        <Setter Property="Background" Value="{DynamicResource Md.Back}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.rail">
        <Setter Property="Foreground" Value="{DynamicResource Md.RailMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TextBox, ComboBox">
        <Setter Property="Background" Value="{DynamicResource Md.InputBack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Md.ButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Md.Fore}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Md.ProgressFill}" />
        <Setter Property="Background" Value="{DynamicResource Md.ProgressBack}" />
    </Style>
    <Style Selector="Grid.reveal">
        <Style.Animations>
            <Animation Duration="0:0:0.24" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="9" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
